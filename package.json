{
  "name": "@hooksvue/big-screen",
  "version": "0.1.1",
  "description": "A lightweight Vue 3 big-screen adaptation library — global plugin + container component dual-mode.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./css-only.css": "./dist/css-only.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build:watch": "vite build --watch",
    "build": "vite build && cpy src/styles/index.css dist --rename=style.css --flat && cpy src/styles/css-only.css dist --flat",
    "build:playground": "vite build --config playground/vite.config.ts",
    "type-check": "vue-tsc --noEmit"
  },
  "keywords": [
    "vue",
    "vue3",
    "big-screen",
    "data-visualization",
    "screen-adapter",
    "autofit",
    "resize",
    "scale"
  ],
  "author": "hooksvue",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@types/node": "^22.0.0",
    "cpy-cli": "^5.0.0",
    "echarts": "^5.5.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
